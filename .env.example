# Copy to .env and tweak for your dev setup. .env is gitignored.

# --- LLM backend (laptop dev) ---
LUMI_LLM_BACKEND=ollama
LUMI_OLLAMA_HOST=http://127.0.0.1:11434
LUMI_OLLAMA_MODEL=qwen2:1.5b

# --- Audio ---
# Leave blank to use system default input/output device. Run `python -m lumi.audio.devices` to list.
LUMI_AUDIO_INPUT_DEVICE=
LUMI_AUDIO_OUTPUT_DEVICE=
LUMI_AUDIO_SAMPLE_RATE=16000
LUMI_AUDIO_RECORD_DURATION_S=5.0

# --- STT (Whisper) ---
LUMI_WHISPER_MODEL=tiny
LUMI_WHISPER_COMPUTE=int8

# --- TTS (Piper) ---
# Piper voice ONNX path. Will be auto-downloaded on first run if missing.
LUMI_PIPER_VOICE=en_US-amy-medium

# --- Face engine ---
LUMI_FACE_WIDTH=480
LUMI_FACE_HEIGHT=320
LUMI_FACE_FPS=30
LUMI_FACE_THEME=pixel

# --- Runtime ---
LUMI_MODE=general
LUMI_WAKE=push_to_talk
LUMI_LOG_LEVEL=INFO

# --- Data paths ---
LUMI_DATA_DIR=./data
LUMI_MODELS_DIR=./models
